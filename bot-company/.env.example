# Copy to .env ON THE HOST ONLY. Never commit .env. Never paste real values into chat,
# prompts, MEMORY.md, or any file tracked in git.
ANTHROPIC_API_KEY=
# Slack (per-bot apps are better than one shared app — see platform/connectors/README.md)
SLACK_BOT_TOKEN_CHIEF=
SLACK_BOT_TOKEN_PROJECT_MAIN=
SLACK_BOT_TOKEN_OPS=
SLACK_APP_TOKEN_SOCKET_MODE=
# GitHub (fine-grained token or GitHub App, draft-PR scope only to start)
GITHUB_TOKEN=
# Google (OAuth client for Gmail + Calendar MCP servers — read/draft scopes first)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sentry (read-only, project bot only, if you use it)
SENTRY_AUTH_TOKEN=
# Virtual card provider API (Phase 5 only — leave empty until then)
VIRTUAL_CARD_API_KEY=
